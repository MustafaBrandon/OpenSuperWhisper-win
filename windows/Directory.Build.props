<Project>

  <!--
    Shared settings for the managed projects under windows/.
    See docs/windows-port.md for the decisions these encode.

    IMPORTANT: everything here is scoped to .csproj.

    MSBuild auto-imports the nearest Directory.Build.props by walking UP from a
    project file, and CMake's Visual Studio generator writes its probe projects
    and the generated whisper.cpp vcxproj files into windows/build/native/.
    Those are under this directory, so without the condition below they would
    import these properties and try to build C++ against a TargetFramework.
    Unconditional properties here break the native build.
  -->

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <!--
      The Windows version is part of the TFM on purpose. Bare `net10.0-windows`
      infers TargetPlatformVersion 7.0, which cannot carry the 22000 floor below
      and fails with NETSDK1135. Nothing here uses WinRT, so targeting the floor
      directly is enough - no need to build against a newer SDK projection.
    -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      InvariantGlobalization must stay FALSE. WPF's font subsystem needs ICU data and
      throws TypeInitializationException on MS.Internal.FontCache.MajorLanguages
      without it. The failure does not appear at startup — the window can be created
      and shown — it appears the first time real text is rendered, which made it look
      like the hotkey was broken rather than the theme. The deployment saving is not
      worth a UI that cannot draw.
    -->

    <!--
      Identity, which ends up in the file properties Explorer shows, in the installer's
      metadata and in its Programs and Features entry, and is what an update check
      compares against.

      Pre-1.0 deliberately: the milestone plan reaches 1.0 when M7 ships a signed
      installer. The minor version tracks the last completed milestone, so 0.6.x is
      "everything through M6".
    -->
    <Product>OpenSuperWhisper</Product>
    <Company>OpenSuperWhisper</Company>
    <Version>0.6.0</Version>
    <Copyright>Copyright © OpenSuperWhisper contributors</Copyright>

    <!-- Rev. 3: x64 only, Windows 11 (build 22000) floor. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    ============================================================
    The ONLY place managed code reaches outside windows/.
    ============================================================
    Keeping these in one file is what makes the eventual subtree
    split a command rather than a migration: at the split, only
    this block needs rewriting. Do not hardcode a relative path
    to the repo root anywhere else.

    The native side has one equivalent: OSW_WHISPER_CPP_DIR in
    native/CMakeLists.txt.
  -->
  <PropertyGroup Label="ExternalPaths" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    <WhisperCppDir>$(RepoRoot)libwhisper\whisper.cpp\</WhisperCppDir>
    <AutocorrectDir>$(RepoRoot)asian-autocorrect\</AutocorrectDir>

    <!-- Default whisper model, bundled with the installer (Rev. 3). -->
    <BundledModelPath>$(RepoRoot)ggml-tiny.en.bin</BundledModelPath>

    <!--
      Silero VAD model. Always required - VAD gating is what stops silence
      producing hallucinated text, so this ships alongside every whisper model.
      Currently borrowed from the mac app's bundle; at the split it moves into
      the standalone repo with the rest.
    -->
    <VadModelPath>$(RepoRoot)OpenSuperWhisper\ggml-silero-v5.1.2.bin</VadModelPath>

    <!-- Reference audio for golden-transcript parity against the mac build. -->
    <SampleAudioPath>$(RepoRoot)jfk.wav</SampleAudioPath>
  </PropertyGroup>

  <PropertyGroup Label="Layout" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <WindowsRoot>$(MSBuildThisFileDirectory)</WindowsRoot>
    <NativeArtifactsDir>$(WindowsRoot)artifacts\native\</NativeArtifactsDir>
    <NativeBuildDir>$(WindowsRoot)build\native\</NativeBuildDir>
  </PropertyGroup>

</Project>
