<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenSuperWhisper.App</RootNamespace>
    <AssemblyName>OpenSuperWhisper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Gives the executable its icon in Explorer, the taskbar and Alt-Tab, and is what
      the installer and Start-menu shortcut will use at M7. Inside windows/, so the
      subtree split carries it.
    -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>

    <!--
      A self-contained publish otherwise carries WPF's framework resources translated
      into fourteen languages - around 130 files and 40 MB - to localise exception
      text the user never sees. The app's own UI is English only.

      This is not trimming: no code is removed and nothing is reached by reflection,
      so it cannot produce the class of failure the plan warns about.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The tray glyph travels as vector data and is rendered at run time: the taskbar
      asks for several pixel sizes across the DPI range, and the colour depends on the
      taskbar theme. See TrayIconFactory.
    -->
    <EmbeddedResource Include="..\..\assets\tray-glyph.path"
                      LogicalName="OpenSuperWhisper.App.tray-glyph.path" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSuperWhisper.Core\OpenSuperWhisper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System tray icon and menu, replacing the mac app's NSStatusItem. -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
  </ItemGroup>

  <!--
    UI Automation needs no explicit Reference: UseWPF brings UIAutomationClient and
    UIAutomationTypes in already, and adding them by hand produces an unresolvable
    conflict with the framework-supplied copies. This is why the UIA caret strategy
    lives in this project rather than Core - Core must not depend on WPF.
  -->

  <ItemGroup>
    <AssemblyMetadata Include="BundledModelPath" Value="$(BundledModelPath)" />
    <AssemblyMetadata Include="VadModelPath" Value="$(VadModelPath)" />
  </ItemGroup>

  <!--
    Model files are copied on PUBLISH only, never on build. They are 77 MB and 1 MB,
    and a dev build reads them straight from the repository through the assembly
    metadata above — copying them into every bin\ would cost a lot for nothing.

    A published app cannot do that: the recorded path is the developer's checkout and
    does not exist on the target machine, so the installed copy has to sit next to the
    executable. AppPaths.ResolveShippedFile looks there first for exactly this reason.
  -->
  <ItemGroup>
    <None Include="$(BundledModelPath)" CopyToPublishDirectory="PreserveNewest"
          Link="ggml-tiny.en.bin" Visible="false" />
    <None Include="$(VadModelPath)" CopyToPublishDirectory="PreserveNewest"
          Link="ggml-silero-v5.1.2.bin" Visible="false" />
  </ItemGroup>

</Project>
