<Window x:Class="OpenSuperWhisper.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenSuperWhisper History"
        Width="780" Height="620"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F9"
        AllowDrop="True"
        Drop="OnFilesDropped"
        DragOver="OnDragOver">

    <DockPanel>
        <!-- Bulk actions, always reachable regardless of scroll position. -->
        <Border DockPanel.Dock="Bottom" Background="#FFEFEFF3" BorderBrush="#FFE2E2E8"
                BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="#FF6B6B76" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DeleteOlderButton" Content="Delete older than 30 days"
                            Height="30" Padding="12,0" Margin="0,0,8,0" Click="OnDeleteOlder" />
                    <Button x:Name="ClearAllButton" Content="Clear all history"
                            Height="30" Padding="12,0" Click="OnClearAll" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Shown instead of the list when history is switched off. -->
        <Border x:Name="DisabledBanner" DockPanel.Dock="Top" Background="#FFFFF4D6"
                BorderBrush="#FFEBD48A" BorderThickness="0,0,0,1" Padding="14,10"
                Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#FF6B5A1F">
                History is switched off, so new dictations are not being saved.
                Existing entries are still listed and can be removed here.
            </TextBlock>
        </Border>

        <Grid Margin="14">
            <ListView x:Name="HistoryList" BorderBrush="#FFE2E2E8" BorderThickness="1"
                      Background="White" SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,8" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding Transcript}" TextWrapping="Wrap"
                                           FontSize="13.5" Foreground="#FF1A1A1E" />
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="#FF8A8A96" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Top" Margin="10,0,0,0">
                                <Button Content="Copy" Width="60" Height="26" Margin="0,0,6,0"
                                        Click="OnCopyOne" Tag="{Binding Id}" />
                                <Button Content="Play" Width="52" Height="26" Margin="0,0,6,0"
                                        Click="OnPlayOne" Tag="{Binding Id}"
                                        IsEnabled="{Binding HasAudio}" />
                                <Button Content="Delete" Width="62" Height="26"
                                        Click="OnDeleteOne" Tag="{Binding Id}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state doubles as the discoverability hint for drag and drop. -->
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FF9A9AA6" FontSize="13" TextAlignment="Center"
                       Visibility="Collapsed">
                No recordings yet.<LineBreak /><LineBreak />
                Dictate with your trigger key, or drop an audio file here to transcribe it.
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
