<Window x:Class="OpenSuperWhisper.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to OpenSuperWhisper"
        Width="560" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F9">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Heading">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1A1A1E" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Body">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="#FF3A3A42" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#FF6B6B76" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FFEFEFF3" BorderBrush="#FFE2E2E8"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip setup"
                        Height="30" Padding="14,0" Click="OnSkip" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Width="90" Height="30"
                            Margin="0,0,8,0" Click="OnBack" />
                    <Button x:Name="NextButton" Content="Next" Width="110" Height="30"
                            Click="OnNext" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24,22,24,10">

            <!-- ======================= 1 · What it does ======================= -->
            <StackPanel x:Name="PageWelcome">
                <TextBlock Style="{StaticResource Heading}" Text="Dictate into any application" />
                <TextBlock Style="{StaticResource Body}"
                           Text="Hold a key, speak, let go. What you said is transcribed on this machine and typed into whatever you were working in — an email, a terminal, a chat box. Nothing is sent anywhere." />

                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,6"
                           Text="Choose the key you want to hold:" />

                <ComboBox x:Name="TriggerCombo" Height="30" Width="260" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="While it is bound, this key does nothing else — it is held back from other applications so it cannot open menus or type. Left Ctrl still works for shortcuts. You can change this later in Settings, including to a key combination such as Alt + `." />
            </StackPanel>

            <!-- ======================= 2 · Try it ======================= -->
            <StackPanel x:Name="PageTry" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Heading}" Text="Try it now" />

                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"
                           Text="Microphone:" />
                <ComboBox x:Name="MicrophoneCombo" Height="30" Margin="0,0,0,14"
                          SelectionChanged="OnMicrophoneChanged" />

                <TextBlock x:Name="TryInstruction" Style="{StaticResource Body}" />

                <Border Background="White" BorderBrush="#FFD8D8E0" BorderThickness="1"
                        CornerRadius="6" Padding="2">
                    <TextBox x:Name="TryBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap"
                             BorderThickness="0" FontSize="13.5" Padding="8"
                             VerticalScrollBarVisibility="Auto" />
                </Border>

                <TextBlock x:Name="TryStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- ======================= 3 · Where it lives ======================= -->
            <StackPanel x:Name="PageDone" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Heading}" Text="Where to find it" />

                <TextBlock Style="{StaticResource Body}"
                           Text="OpenSuperWhisper has no main window. It sits in the notification area, at the right-hand end of the taskbar — Windows 11 hides new icons there, so click the chevron (˄) to see it, and drag it out if you want it visible." />

                <TextBlock Style="{StaticResource Body}"
                           Text="Right-click that icon for your microphone, the transcription language, your history, and settings. Downloading a larger model in Settings is the single biggest accuracy improvement available — the bundled model is fast and weak." />

                <TextBlock Style="{StaticResource Body}"
                           Text="Recordings and transcripts are kept on this machine so you can review them. You can turn that off, or clear it, in Settings." />

                <TextBlock Style="{StaticResource Hint}"
                           Text="Drop an audio file on the History window — or open one with this app — to transcribe a file you already have." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
